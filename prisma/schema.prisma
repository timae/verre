generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                        Int                    @id @default(autoincrement())
  name                      String                 @db.VarChar(64)
  email                     String                 @unique @db.VarChar(255)
  passwordHash              String                 @map("password_hash") @db.VarChar(255)
  role                      String                 @default("taster") @db.VarChar(16)
  pro                       Boolean                @default(false)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  // XP from rating wines, hosting sessions, etc. — separate from lifetime_*
  // because XP is a sum of weighted action points, not a count of actions.
  xp                        Int                    @default(0)
  tokenVersion              Int                    @default(0) @map("token_version")
  // Snapshot counters — monotonic, never decrement. Drive badge progression
  // and shield user achievement state from rating deletions (e.g. when a
  // host deletes a session that contained the user's ratings).
  lifetimeRatings           Int                    @default(0) @map("lifetime_ratings")
  lifetimeFiveStar          Int                    @default(0) @map("lifetime_five_star")
  lifetimeOneStar           Int                    @default(0) @map("lifetime_one_star")
  lifetimeNotesWritten      Int                    @default(0) @map("lifetime_notes_written")
  lifetimeMaxNoteLength     Int                    @default(0) @map("lifetime_max_note_len")
  lifetimeSessionsJoined    Int                    @default(0) @map("lifetime_sessions_joined")
  lifetimeSessionsHosted    Int                    @default(0) @map("lifetime_sessions_hosted")
  lifetimePhotosAdded       Int                    @default(0) @map("lifetime_photos_added")
  lifetimeConsecutiveMonths Int                    @default(0) @map("lifetime_consecutive_months")
  firstRatedAt              DateTime?              @map("first_rated_at") @db.Timestamp(6)
  imageUrl                  String?                @map("image_url") @db.VarChar(512)
  // Profile visibility — see lib/profileVisibility.ts. Stored as VARCHAR(32)
  // (not a Postgres enum) so a future tier ('private', etc.) is a code-only
  // change. A CHECK constraint is hand-added in the migration; the lib-side
  // union type in ProfileVisibility is the authoritative source of truth.
  profileVisibility         String                 @default("public-users") @map("profile_visibility") @db.VarChar(32)
  visibilityFof             Boolean                @default(false) @map("visibility_fof")
  bookmarks                 Bookmark[]
  hofEntries                HallOfFame[]
  ratings                   Rating[]
  members                   SessionMember[]
  hostedSessions            Session[]
  earnedBadges              UserBadge[]
  followers                 Follow[]               @relation("UserFollowing")
  following                 Follow[]               @relation("UserFollowers")
  checkins                  Checkin[]
  checkinLikes              CheckinLike[]
  checkinTags               CheckinTag[]
  visibilityLog             ProfileVisibilityLog[]
  mutes                     UserMute[]             @relation("UserMuter")
  mutedBy                   UserMute[]             @relation("UserMuted")
  blocks                    UserBlock[]            @relation("UserBlocker")
  blockedBy                 UserBlock[]            @relation("UserBlocked")

  // pg_trgm GIN index for fast substring search in /api/users/search.
  // The `raw("gin_trgm_ops")` operator class is what makes ILIKE queries
  // index-eligible; without it the index would only support the default
  // tsvector lookups.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

// Audit trail of every profile_visibility / visibility_fof change. Internal
// only — no API surface, no UI. Forensic safety net for dispute resolution
// ("my profile was public yesterday") and incident response. Tombstones on
// user delete (user_id → NULL) so the audit trail survives account
// deletion; rows themselves are never auto-purged.
model ProfileVisibilityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromTier  String?  @map("from_tier") @db.VarChar(32)
  toTier    String   @map("to_tier") @db.VarChar(32)
  fromFof   Boolean? @map("from_fof")
  toFof     Boolean? @map("to_fof")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([userId, changedAt])
  @@map("profile_visibility_log")
}

// Per-pair soft-hide. A mutes B → A no longer sees B's content in
// A's feed. B is unaware. Independent of follow state; doesn't gate
// direct profile reads, search, likes, tags, or sessions.
model UserMute {
  muterId   Int      @map("muter_id")
  mutedId   Int      @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  muter     User     @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  muted     User     @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([muterId, mutedId])
  @@index([mutedId])
  @@map("user_mutes")
}

// Per-pair block. Stronger than mute: A blocks B → bidirectional
// invisibility OUTSIDE shared sessions. Profile reads, feed, search,
// follower/following lists & counts, like counts, tag rendering all
// hide the pair edge globally for everyone (Instagram-style). INSIDE
// a shared session the block goes dormant: render-style only, no
// row hiding, no identity-map mutation. Outside-session links from
// session contexts (e.g. tapping a participant's name → /u/<id>) hit
// the outside-session gate again.
//
// Block is non-destructive: follows, mutes, likes, tags between the
// pair stay in DB. Unblock restores visibility everywhere.
//
// Separate from Kick/Ban (per-session moderation primitive).
model UserBlock {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Session {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(16)
  hostUserId  Int?      @map("host_user_id")
  hostName    String    @map("host_name") @db.VarChar(64)
  blind       Boolean   @default(false)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime  @default(now()) @map("archived_at") @db.Timestamptz(6)
  name        String?   @db.VarChar(255)
  address     String?   @db.VarChar(255)
  dateFrom    DateTime? @map("date_from") @db.Timestamptz(6)
  dateTo      DateTime? @map("date_to") @db.Timestamptz(6)
  timezone    String?   @db.VarChar(64)
  description String?
  link        String?   @db.VarChar(512)
  host        User?     @relation(fields: [hostUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wines       Wine[]

  @@map("sessions")
}

model Wine {
  id          String     @id @db.VarChar(20)
  // Nullable so wines can be retained when their session is deleted —
  // bookmarked wines stay reachable from the bookmark page even after the
  // hosting session is gone. Wines with sessionId=NULL are orphans.
  sessionId   Int?       @map("session_id")
  name        String     @db.VarChar(255)
  producer    String?    @db.VarChar(255)
  vintage     String?    @db.Char(4)
  grape       String?    @db.VarChar(255)
  category    String     @default("wine") @db.VarChar(32)
  style       String?    @db.VarChar(64)
  imageUrl    String?    @map("image_url")
  purchaseUrl String?    @map("purchase_url") @db.VarChar(1000)
  description String?    @db.VarChar(1000)
  region      String?    @db.VarChar(255)
  country     String?    @db.VarChar(2)
  vinification String?   @db.VarChar(1000)
  revealedAt  DateTime?  @map("revealed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  // Identity-id of the user or anon who added this wine. Used by kick/ban
  // to identify which wines a host can choose to orphan when removing a
  // participant. Nullable for existing rows (provenance unknown) — those
  // never match a ban-target filter and stay untouched.
  addedByIdentityId String?    @map("added_by_identity_id") @db.VarChar(64)
  // Snapshot of the adder's display name at create time. Frozen — edits
  // never refresh this. The live identities map is preferred at read
  // time; this is a fallback for when the adder has been kicked/banned
  // (logged-in users fall through to users.name first; anon adders rely
  // on this snapshot since there's no users row).
  addedByDisplayName String?   @map("added_by_display_name") @db.VarChar(64)
  bookmarks   Bookmark[]
  ratings     Rating[]
  session     Session?   @relation(fields: [sessionId], references: [id], onUpdate: NoAction)

  @@index([sessionId, addedByIdentityId])
  @@map("wines")
}

model Rating {
  id        Int      @id @default(autoincrement())
  wineId    String   @map("wine_id") @db.VarChar(20)
  userId    Int?     @map("user_id")
  raterName String   @map("rater_name") @db.VarChar(64)
  // Decimal(3,2) accepts 0.00 through 5.00 in 0.25 increments.
  // Stored as numeric so AVG / GREATEST / range comparisons work
  // directly in SQL. Validation enforces the 0.25-step constraint at
  // the route layer (lib/checkinValidation.ts).
  score     Decimal  @db.Decimal(3, 2)
  flavors   Json     @default("{}")
  notes     String?
  ratedAt   DateTime @map("rated_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wine      Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wineId, userId])
  @@index([userId])
  @@map("ratings")
}

model SessionMember {
  userId      Int      @map("user_id")
  sessionCode String   @map("session_code") @db.VarChar(16)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  role        String   @default("taster") @db.VarChar(16)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // No FK to Session — session_code links to Redis; Postgres session row may not exist yet

  @@id([userId, sessionCode])
  @@map("session_members")
}

model Bookmark {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  wineId  String   @map("wine_id") @db.VarChar(20)
  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wine    Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wineId])
  @@map("bookmarks")
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  wineName    String   @map("wine_name") @db.VarChar(255)
  producer    String?  @db.VarChar(255)
  vintage     String?  @db.Char(4)
  category    String   @default("wine") @db.VarChar(32)
  style       String?  @db.VarChar(64)
  // Quarter-stars: 0.00 through 5.00 in 0.25 steps. HoF entries are
  // currently created only on score === 5.00 (strict five-star), so
  // existing rows stay at 5.00 after the type widen.
  score       Decimal  @db.Decimal(3, 2)
  raterName   String   @map("rater_name") @db.VarChar(64)
  userId      Int?     @map("user_id")
  sessionCode String?  @map("session_code") @db.VarChar(16)
  ratedAt     DateTime @map("rated_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([wineName, userId])
  @@map("hall_of_fame")
}

// Badge catalog. Seeded from lib/badges.ts via ensureBadgesSeedOnce().
// IDs are stable string keys ("first_pour", "rated_10", etc.), not
// autoincrement integers — easier to reference from code.
model Badge {
  id          String      @id @db.VarChar(60)
  name        String      @db.VarChar(100)
  description String      @db.VarChar(255)
  icon        String      @db.VarChar(10)
  category    String      @db.VarChar(30)
  rarity      String      @default("common") @db.VarChar(20)
  xpReward    Int         @default(50) @map("xp_reward")
  earnedBy    UserBadge[]

  @@map("badges")
}

// Awarded-badge join table. (userId, badgeId) is unique — a user can earn
// each badge at most once. `seen` flips to true when the user views their
// badges list, used to drive the "new badge" notification dot.
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  badgeId  String   @map("badge_id") @db.VarChar(60)
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)
  seen     Boolean  @default(false)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ── Social Feed ───────────────────────────────────────────────

// Explicit social graph — who follows whom.
model Follow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// Standalone wine check-ins — log a bottle outside a session.
model Checkin {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  wineName  String        @map("wine_name") @db.VarChar(255)
  producer  String?       @db.VarChar(255)
  vintage   String?       @db.Char(4)
  grape     String?       @db.VarChar(255)
  type      String?       @db.VarChar(16)
  // Quarter-stars: 0.00 through 5.00 in 0.25 steps; null when the
  // user hasn't rated this check-in yet (the check-in row exists for
  // the wine identity + flavors + notes alone).
  score     Decimal?      @db.Decimal(3, 2)
  flavors   Json          @default("{}")
  notes     String?
  imageUrl  String?       @map("image_url")
  venueName String?       @map("venue_name") @db.VarChar(255)
  city      String?       @db.VarChar(100)
  country   String?       @db.Char(2)
  lat       Decimal?      @db.Decimal(9, 6)
  lng       Decimal?      @db.Decimal(9, 6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CheckinLike[]
  tags      CheckinTag[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("checkins")
}

model CheckinTag {
  checkinId Int     @map("checkin_id")
  userId    Int     @map("user_id")
  checkin   Checkin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([checkinId, userId])
  @@index([userId])
  @@map("checkin_tags")
}

model CheckinLike {
  userId    Int      @map("user_id")
  checkinId Int      @map("checkin_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkin   Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  @@id([userId, checkinId])
  @@map("checkin_likes")
}
