generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // unaccent powers accent-insensitive moments search (GET /api/me/sessions
  // ?q); pg_trgm adds the typo-tolerant word_similarity fallback. The
  // f_unaccent() IMMUTABLE wrapper + any functional trgm index live in raw
  // migration SQL (Prisma's datamodel can't express a function or an
  // expression index; migrate diff ignores both, so no schema drift).
  // ⚠️ "migrate diff ignores it" holds only for what Prisma cannot MODEL. It
  // does NOT hold for generated COLUMNS or named indexes on them — those are
  // visible to the diff and must be declared (see the wine-catalog folded
  // columns, which carry @default(dbgenerated(...)) for exactly this reason).
  extensions = [pg_trgm, unaccent]
}

model User {
  id                        Int                    @id @default(autoincrement())
  name                      String                 @db.VarChar(64)
  email                     String                 @unique @db.VarChar(255)
  // Nullable since native auth (Better Auth): a social-only user (Google/Apple)
  // has NO password — Better Auth inserts a users row writing name/email/
  // timestamps but never password_hash (credentials live in auth_accounts).
  // NOT NULL would 500 the first social sign-up. Every bcrypt.compare consumer
  // MUST guard the null hash before comparing (auth.ts feeds ?? DUMMY_HASH;
  // account PATCH/DELETE + lib/verifyPassword guard explicitly). See
  // docs/dev/proposals/mobile-app/01-identity-and-auth.md §4.
  passwordHash              String?                @map("password_hash") @db.VarChar(255)
  // Additive columns Better Auth requires on its `user` model (mapped onto this
  // table). Both defaulted → additive-safe on the populated table; NextAuth
  // ignores them. updated_at is @default(now()) WITHOUT @updatedAt: Better Auth
  // manages it in its own writes, and leaving Prisma's auto-bump off keeps the
  // dual-store decoupled (no race between BA's explicit set and a Prisma bump on
  // every existing prisma.user.update). See proposal §4.
  emailVerified             Boolean                @default(false) @map("email_verified")
  updatedAt                 DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  role                      String                 @default("taster") @db.VarChar(16)
  pro                       Boolean                @default(false)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  // XP from rating wines, hosting sessions, etc. — separate from lifetime_*
  // because XP is a sum of weighted action points, not a count of actions.
  xp                        Int                    @default(0)
  tokenVersion              Int                    @default(0) @map("token_version")
  // Snapshot counters — monotonic, never decrement. Drive badge progression
  // and shield user achievement state from rating deletions (e.g. when a
  // host deletes a session that contained the user's ratings).
  lifetimeRatings           Int                    @default(0) @map("lifetime_ratings")
  lifetimeFiveStar          Int                    @default(0) @map("lifetime_five_star")
  lifetimeOneStar           Int                    @default(0) @map("lifetime_one_star")
  lifetimeNotesWritten      Int                    @default(0) @map("lifetime_notes_written")
  lifetimeMaxNoteLength     Int                    @default(0) @map("lifetime_max_note_len")
  lifetimeSessionsJoined    Int                    @default(0) @map("lifetime_sessions_joined")
  lifetimeSessionsHosted    Int                    @default(0) @map("lifetime_sessions_hosted")
  lifetimePhotosAdded       Int                    @default(0) @map("lifetime_photos_added")
  lifetimeConsecutiveMonths Int                    @default(0) @map("lifetime_consecutive_months")
  firstRatedAt              DateTime?              @map("first_rated_at") @db.Timestamp(6)
  imageUrl                  String?                @map("image_url") @db.VarChar(512)
  // Profile visibility — see lib/profileVisibility.ts. Stored as VARCHAR(32)
  // (not a Postgres enum) so a future tier ('private', etc.) is a code-only
  // change. A CHECK constraint is hand-added in the migration; the lib-side
  // union type in ProfileVisibility is the authoritative source of truth.
  profileVisibility         String                 @default("public-users") @map("profile_visibility") @db.VarChar(32)
  visibilityFof             Boolean                @default(false) @map("visibility_fof")
  bookmarks                 Bookmark[]
  hofEntries                HallOfFame[]
  ratings                   Rating[]
  members                   SessionMember[]
  hostedSessions            Session[]
  earnedBadges              UserBadge[]
  followers                 Follow[]               @relation("UserFollowing")
  following                 Follow[]               @relation("UserFollowers")
  visibilityLog             ProfileVisibilityLog[]
  mutes                     UserMute[]             @relation("UserMuter")
  mutedBy                   UserMute[]             @relation("UserMuted")
  blocks                    UserBlock[]            @relation("UserBlocker")
  blockedBy                 UserBlock[]            @relation("UserBlocked")
  feedItems                 FeedItem[]
  feedItemLikes             FeedItemLike[]
  feedItemTags              FeedItemTag[]
  userSessions              UserSession[]
  authAccounts              AuthAccount[]
  authSessions              AuthSession[]
  staffRoles                StaffRole[]            @relation("StaffRoleHolder")
  staffRolesGranted         StaffRole[]            @relation("StaffRoleGranter")
  // Catalog attribution. All SetNull — community catalog rows are never
  // cascaded by a user deletion (lib/accountDelete.ts needs no catalog
  // handling beyond what SetNull gives; its tests should pin that).
  producersAdded            Producer[]             @relation("ProducerAdder")
  producersCurated          Producer[]             @relation("ProducerCurator")
  productsAdded             WineProduct[]          @relation("ProductAdder")
  productsCurated           WineProduct[]          @relation("ProductCurator")
  vintagesAdded             WineVintage[]          @relation("VintageAdder")
  vintagesCurated           WineVintage[]          @relation("VintageCurator")

  // pg_trgm GIN index for fast substring search in /api/users/search.
  // The `raw("gin_trgm_ops")` operator class is what makes ILIKE queries
  // index-eligible; without it the index would only support the default
  // tsvector lookups.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

// Audit trail of every profile_visibility / visibility_fof change. Internal
// only — no API surface, no UI. Forensic safety net for dispute resolution
// ("my profile was public yesterday") and incident response. Tombstones on
// user delete (user_id → NULL) so the audit trail survives account
// deletion; rows themselves are never auto-purged.
model ProfileVisibilityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromTier  String?  @map("from_tier") @db.VarChar(32)
  toTier    String   @map("to_tier") @db.VarChar(32)
  fromFof   Boolean? @map("from_fof")
  toFof     Boolean? @map("to_fof")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([userId, changedAt])
  @@map("profile_visibility_log")
}

// One row per active credential login (the "Connected devices" feature). The
// signed JWT carries this row's `id`; the auth.ts jwt() revalidation callback
// looks up `revokedAt` on every authenticated request, so per-device sign-out
// and revoke-on-password-change become a single UPDATE. Replaces the never-
// written `users.tokenVersion` revocation mechanism (column kept in v1, dropped
// in v1.1). See docs/dev/proposals/auth-sessions.md.
model UserSession {
  // uuid v4 ONLY (NOT v7). The id is baked into the signed JWT; v4's 122 bits
  // of randomness keep it unguessable even under a hypothetical AUTH_SECRET
  // leak. v7 would leak creation time + reduce tail randomness. gen_random_uuid()
  // (what @default(uuid()) resolves to) is v4.
  id          String    @id @default(uuid()) @db.Uuid
  userId      Int       @map("user_id")
  // Derived labels parsed at authorize() time — raw User-Agent and raw IP are
  // NEVER persisted (privacy minimisation, see proposal §4). deviceLabel from
  // lib/userAgent.ts; geoLabel is country-only from lib/geo.ts (null on miss).
  deviceLabel String?   @map("device_label") @db.VarChar(64)
  geoLabel    String?   @map("geo_label") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Bumped at coarse 5-min wall-clock buckets by the jwt() revalidation branch.
  // Self-only field: queryable only via WHERE userId = $self. No analytics /
  // other-user / aggregate surface (proposal §10).
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Why the session was revoked, set alongside revokedAt. Lets the login page
  // show a tailored message (e.g. "your password was changed") when a device
  // whose session was killed by a password change next hits the app. Values:
  // 'password_change' | 'manual' | 'revoke_all' | 'logout'. Null when active.
  revocationReason String? @map("revocation_reason") @db.VarChar(32)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ── Better Auth (native-app auth) ─────────────────────────────
// Hand-authored through Verre's gated Prisma pipeline — the Better Auth CLI
// must NEVER own/migrate these (or `users`). Table names are PINNED to avoid
// collision with the existing @@map("sessions") (wine sessions) + user_sessions.
// PKs are Int autoincrement on all 3 tables (generateId:"serial" — see the
// AuthAccount comment below for why no other id mode works). `user_id` is the
// Int FK → users.id, onDelete: Cascade matching user_sessions so the raw
// `DELETE FROM users` in lib/accountDelete.ts doesn't 500 once a user has
// Better Auth rows.
// See docs/dev/proposals/mobile-app/01-identity-and-auth.md §4–§6.
//
// String columns are intentionally bare String (→ Postgres TEXT), NOT @db.VarChar
// — these are Better-Auth-owned shapes (ids/tokens it generates, OAuth tokens it
// stores). Capping them risks silent truncation if BA ever emits a longer value.
// This deliberately diverges from the schema's otherwise cap-everything convention.

// Credentials + linked social identities. providerId='credential' rows hold the
// bcrypt password hash (lazily backfilled from users.password_hash on first
// native login); providerId='google'/'apple' rows are linked social accounts.
//
// Int-serial PKs on all 3 auth tables: Better Auth 1.6.15 round-trips Int FKs
// (users.id → user_id) ONLY under generateId:"serial", which is global — it
// forces Int autoincrement ids on every BA table. Mixed-id (String PKs here,
// Int users.id) is NOT supported: the adapter stringifies ids on output unless
// serial mode is on, so the FK write fails (GH #3450; verified against the
// 1.6.15 adapter source). See proposal §4.
model AuthAccount {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

// Opaque Better Auth sessions. ⚠️ This table is NOT the source of truth on its
// own: with secondaryStorage configured (lib/betterAuth.ts), BA writes sessions
// to BOTH this table and Redis and serves reads Redis-FIRST — so deleting a row
// here does NOT revoke (the Redis copy stays live until TTL). Every revocation
// must go through Better Auth — lib/identityStore.ts's internalAdapter legs —
// which deletes both stores. `token` is the opaque session token looked up per
// request (unique). ipAddress/userAgent hold DERIVED LABELS (country name,
// "OS · Browser"), never raw values — a session.create.before hook in
// lib/betterAuth.ts converts at write time (privacy parity with user_sessions).
model AuthSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("auth_sessions")
}

// Short-lived verification tokens (email verification, etc.). Keyed on
// `identifier` (e.g. an email), NOT a user_id — so no FK / cascade here.
model AuthVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

// Per-pair soft-hide. A mutes B → A no longer sees B's content in
// A's feed. B is unaware. Independent of follow state; doesn't gate
// direct profile reads, search, likes, tags, or sessions.
model UserMute {
  muterId   Int      @map("muter_id")
  mutedId   Int      @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  muter     User     @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  muted     User     @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([muterId, mutedId])
  @@index([mutedId])
  @@map("user_mutes")
}

// Per-pair block. Stronger than mute: A blocks B → bidirectional
// invisibility OUTSIDE shared sessions. Profile reads, feed, search,
// follower/following lists & counts, like counts, tag rendering all
// hide the pair edge globally for everyone (Instagram-style). INSIDE
// a shared session the block goes dormant: render-style only, no
// row hiding, no identity-map mutation. Outside-session links from
// session contexts (e.g. tapping a participant's name → /u/<id>) hit
// the outside-session gate again.
//
// Block is non-destructive: follows, mutes, likes, tags between the
// pair stay in DB. Unblock restores visibility everywhere.
//
// Separate from Kick/Ban (per-session moderation primitive).
model UserBlock {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Session {
  id          Int        @id @default(autoincrement())
  // Every column except `id` and `deletedAt` is nullable: phase 2 soft-delete
  // scrubs them to NULL per the §8 data-survival contract. Unique on `code`
  // still works — Postgres treats multiple NULLs as distinct.
  code        String?    @unique @db.VarChar(16)
  hostUserId  Int?       @map("host_user_id")
  hostName    String?    @map("host_name") @db.VarChar(64)
  blind            Boolean?
  blindForEveryone Boolean?  @map("blind_for_everyone")
  createdAt   DateTime?  @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime?  @default(now()) @map("archived_at") @db.Timestamptz(6)
  name        String?    @db.VarChar(255)
  address     String?    @db.VarChar(255)
  dateFrom    DateTime?  @map("date_from") @db.Timestamptz(6)
  dateTo      DateTime?  @map("date_to") @db.Timestamptz(6)
  timezone    String?    @db.VarChar(64)
  description String?
  link        String?    @db.VarChar(512)
  // Host-chosen cover photo (S3 URL, sessions/{code}_{ts}.{ext}). Deliberately
  // NOT blind-redacted — it brands the moment, not a wine. S3 bytes are
  // reclaimed in every deletion path (capture/commit/reclaim-after).
  coverPhotoUrl String? @map("cover_photo_url") @db.VarChar(512)
  // Session-level category — the future contract for what impressions can be
  // added ('wine' → wines only) and the category vocabulary. Plain varchar
  // like wines.category (the category_styles lookup PK is the composite
  // (category, style), so no single-column FK). v1 allow-list: 'wine'.
  // Nullable for the soft-delete scrub contract; create writes 'wine'.
  category    String?    @db.VarChar(32)
  // Soft-delete tombstone marker. NULL = live; non-null = deleted at this
  // instant, with every other column scrubbed to NULL per the §8 data-survival
  // contract in docs/dev/proposals/rewire.md. The row itself stays so
  // `ratings.session_id` and `feed_items.session_id` keep their grouping
  // signal; renderers JOIN sessions to display "[deleted session]".
  // Partial index `sessions_live_idx` (added in migration SQL) makes the
  // dominant `WHERE deleted_at IS NULL` filter selective.
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  host        User?      @relation(fields: [hostUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wines       Wine[]
  ratings     Rating[]
  feedItems   FeedItem[]

  @@map("sessions")
}

model Wine {
  // Widened to VarChar(21) for standard 21-char nanoid generation (replacing
  // Date.now().toString() which collided under concurrent inserts). Existing
  // rows keep their shorter timestamp-string ids — they still fit.
  id                 String         @id @db.VarChar(21)
  // Nullable so wines can be retained when their session is deleted —
  // bookmarked wines stay reachable from the bookmark page even after the
  // hosting session is gone. Wines with sessionId=NULL are orphans.
  sessionId          Int?           @map("session_id")
  name               String         @db.VarChar(255)
  producer           String?        @db.VarChar(255)
  vintage            String?        @db.Char(4)
  grape              String?        @db.VarChar(255)
  category           String         @default("wine") @db.VarChar(32)
  style              String?        @db.VarChar(64)
  imageUrl           String?        @map("image_url")
  // Catalog links — the wine instance points at the shared catalog at TWO
  // grains, because wine_vintages.year = null means the NV instance and never
  // "year unknown": an unknown-year wine links at product grain with
  // vintageId null. Valid states: (set, set) | (set, null) | (null, null).
  // (null, set) is rejected by a CHECK in the migration — the composite FK
  // below is MATCH SIMPLE, so it skips whenever either column is null and
  // would NOT catch it. Both stay mutable so a future user-correction re-link
  // needs no schema change; catalog identity is never denormalised onto
  // ratings. Set only from an explicit user choice or a freshly-minted
  // provisional, never from a string match (sole exception: the phase-5
  // legacy backfill). See docs/dev/proposals/wine-catalog.md § v1 data model.
  productId          String?        @map("product_id") @db.VarChar(21)
  vintageId          String?        @map("vintage_id") @db.VarChar(21)
  purchaseUrl        String?        @map("purchase_url") @db.VarChar(1000)
  description        String?        @db.VarChar(1000)
  region             String?        @db.VarChar(255)
  country            String?        @db.VarChar(2)
  vinification       String?        @db.VarChar(1000)
  revealedAt         DateTime?      @map("revealed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // Identity-id of the user or anon who added this wine. Used by kick/ban
  // to identify which wines a host can choose to orphan when removing a
  // participant. Nullable for existing rows (provenance unknown) — those
  // never match a ban-target filter and stay untouched.
  addedByIdentityId  String?        @map("added_by_identity_id") @db.VarChar(64)
  // Snapshot of the adder's display name. Frozen on ordinary edits.
  // EXCEPTION: a host/cohost "change who brought it" reassignment (ownership-
  // only PATCH /wines/[wineId] broughtByIdentityId) rewrites this and
  // added_by_identity_id to the new owner. The live identities map is preferred
  // at read time; this is a fallback for when the adder has been kicked/banned
  // (logged-in users fall through to users.name first; anon adders rely on this
  // snapshot since there's no users row).
  addedByDisplayName String?        @map("added_by_display_name") @db.VarChar(64)
  bookmarks          Bookmark[]
  ratings            Rating[]
  session            Session?       @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  // Composite FK to category_styles guarantees (category, style) is a valid
  // pair. Style is nullable; the FK only enforces when both columns are
  // non-null (Postgres default MATCH SIMPLE). Pre-flight confirmed every
  // existing row has a canonical pair; no backfill needed.
  categoryStyle      CategoryStyle? @relation(fields: [category, style], references: [category, style], onDelete: NoAction, onUpdate: NoAction)
  // 🔒 The composite FK above is MATCH SIMPLE, so it checks NOTHING when
  // `style` is null — and style is nullable. This single-column FK is what
  // actually constrains `category` (measured: `category='spirit', style=NULL`
  // inserted cleanly before it existed). The two are complementary: the
  // composite rejects a wrong style FOR a category, this rejects the category.
  categoryRef        Category       @relation(fields: [category], references: [category], onDelete: NoAction, onUpdate: NoAction)
  // NoAction on both catalog FKs: ordinary lifecycle NEVER deletes catalog
  // rows (merge is a pointer, not a delete). The exceptional staff hard-purge
  // performs the exact column transitions itself in one transaction, and these
  // Restrict-equivalent FKs are the backstop — a purge that forgets a
  // reference class fails and rolls back rather than half-applying. An
  // ON DELETE SET NULL on the composite FK would be actively wrong: it would
  // null BOTH columns when only the vintage disappears, silently unlinking the
  // wine from a product that still exists.
  product            WineProduct?   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Composite FK guarantees a chosen vintage BELONGS to the stored product.
  // Targets wine_vintages (id, product_id) — hence the redundant UNIQUE on
  // that pair. Enforced exactly when both columns are set (MATCH SIMPLE).
  // Named catalogVintage, not `vintage` — the scalar `vintage` above is the
  // historical year snapshot on the instance and is a different thing.
  catalogVintage     WineVintage?   @relation(fields: [vintageId, productId], references: [id, productId], onDelete: NoAction, onUpdate: NoAction)

  @@index([sessionId, addedByIdentityId])
  // Roll-up path for the product/vintage aggregate pages (phase 5) and the
  // purge-time reference sweep: both walk wines by catalog link.
  @@index([productId])
  @@index([vintageId])
  // pg_trgm GIN indexes for the future Tastes-tab search/filter on wine name
  // + producer. Adding now is cheap and avoids a post-import rebuild on a
  // larger table later. `raw("gin_trgm_ops")` makes ILIKE queries
  // index-eligible (the default would only support tsvector lookups).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([producer(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("wines")
}

model Rating {
  id        Int           @id @default(autoincrement())
  wineId    String        @map("wine_id") @db.VarChar(21)
  userId    Int?          @map("user_id")
  // NEW (phase 1): direct FK to the originating session. NULL for standalone
  // ratings; non-null for in-session ratings. Backfilled in this phase's
  // migration from wines.session_id. Survives session-delete because the
  // sessions row is soft-deleted (§8 contract).
  sessionId Int?          @map("session_id")
  // NEW (phase 1): provenance tag — how the rating came into being.
  // 'session' | 'standalone' today; future: 'imported', 'restaurant_api',
  // 'bottle_scan', etc. Immutable once set. Distinct from session-membership
  // (sessionId) — see rewire.md §2 for the why.
  origin    String        @db.VarChar(32)
  raterName String        @map("rater_name") @db.VarChar(64)
  // Decimal(3,2) accepts 0.00 through 5.00 in 0.25 increments.
  // Stored as numeric so AVG / GREATEST / range comparisons work
  // directly in SQL. Validation enforces the 0.25-step constraint at
  // the route layer (lib/checkinValidation.ts).
  // Nullable since phase 1.5: a chips-only or notes-only rating row
  // has no score, distinct from `score = 0` ("not rated"). See
  // rewire.md §3 (engagement rule) and §2 score-nullable reasoning.
  score     Decimal?      @db.Decimal(3, 2)
  flavors   Json          @default("{}")
  // Aroma descriptor selections — array of {a: nodeId, m: modifierId|null,
  // p?: true} entries from the @verre/core taxonomy (`p` = pronounced,
  // present only when true; re-keyed from `d` 2026-07-10 while zero rows
  // carried it — comment-only change, no migration). Capped + gated at the
  // write boundary (lib/aromas.ts gateAromas). The node may sit at any tier
  // (leaf "strawberry", subfamily "fruity.berry", family "fruity" — the
  // stored grain encodes the taster's confidence; any-tier ruling
  // 2026-07-08). '[]' is the empty signal the engagement cascade matches
  // alongside flavors = '{}'. Tier roll-ups derive from the taxonomy at
  // read time, never stored. See docs/dev/proposals/aroma/aroma-layer.md §4.
  aromas    Json          @default("[]")
  notes     String?
  ratedAt   DateTime      @map("rated_at") @db.Timestamptz(6)
  // Restrict matches the §2 design: hard-deleting a referenced session
  // should fail loudly. Soft-delete (sessions.deletedAt) is the contract;
  // any future GDPR purge must null this FK explicitly first.
  session   Session?      @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user      User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wine      Wine          @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  images    RatingImage[]
  feedItem  FeedItem?

  // Phase 1.5 dropped @@unique([wineId, userId]) in favour of a raw
  // partial unique on (user_id, wine_id, session_id) WHERE session_id
  // IS NOT NULL AND user_id IS NOT NULL — declared in the migration
  // because Prisma can't express partial uniques in schema.prisma.
  // Standalone ratings (session_id IS NULL) are intentionally
  // unconstrained: a user can have multiple standalone tastings of
  // the same wine over time (rewire.md §2).
  @@index([userId])
  @@index([sessionId])
  @@index([userId, wineId])
  @@index([userId, sessionId])
  @@map("ratings")
}

model SessionMember {
  userId      Int      @map("user_id")
  sessionCode String   @map("session_code") @db.VarChar(16)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  role        String   @default("taster") @db.VarChar(16)
  // Durable kick-state mirror of the Redis `s:<C>:kicked` set (which expires
  // with the session). NULL = active member; 'kicked' = kick-KEEP (the row
  // survives per docs/dev/kick-ban.md, but the user is out). Written by the
  // kick path (lib/sessionWipe.ts) and cleared on rejoin (join route); kick-
  // delete/ban DELETE the row so they never carry it. Lets /api/me/sessions
  // exclude kicked moments in SQL — exact counts + lists without a per-row
  // Redis SISMEMBER. A slice of the durable-sessions workstream (Postgres-
  // authoritative moderation state).
  removedState String? @map("removed_state") @db.VarChar(16)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // No FK to Session — session_code links to Redis; Postgres session row may not exist yet

  @@id([userId, sessionCode])
  // The composite PK can't serve a filter/join on the non-leading
  // session_code column. The feed network self-join and /me/sessions both
  // join on session_code; without this index they degrade to seq scans.
  @@index([sessionCode])
  @@map("session_members")
}

model Bookmark {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  wineId  String   @map("wine_id") @db.VarChar(21)
  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wine    Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wineId])
  @@map("bookmarks")
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  wineName    String   @map("wine_name") @db.VarChar(255)
  producer    String?  @db.VarChar(255)
  vintage     String?  @db.Char(4)
  category    String   @default("wine") @db.VarChar(32)
  style       String?  @db.VarChar(64)
  // Quarter-stars: 0.00 through 5.00 in 0.25 steps. HoF entries are
  // currently created only on score === 5.00 (strict five-star), so
  // existing rows stay at 5.00 after the type widen.
  score       Decimal  @db.Decimal(3, 2)
  raterName   String   @map("rater_name") @db.VarChar(64)
  userId      Int?     @map("user_id")
  sessionCode String?  @map("session_code") @db.VarChar(16)
  ratedAt     DateTime @map("rated_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([wineName, userId])
  @@map("hall_of_fame")
}

// Badge catalog. Seeded from lib/badges.ts via ensureBadgesSeedOnce().
// IDs are stable string keys ("first_pour", "rated_10", etc.), not
// autoincrement integers — easier to reference from code.
model Badge {
  id          String      @id @db.VarChar(60)
  name        String      @db.VarChar(100)
  description String      @db.VarChar(255)
  icon        String      @db.VarChar(10)
  category    String      @db.VarChar(30)
  rarity      String      @default("common") @db.VarChar(20)
  xpReward    Int         @default(50) @map("xp_reward")
  earnedBy    UserBadge[]

  @@map("badges")
}

// Awarded-badge join table. (userId, badgeId) is unique — a user can earn
// each badge at most once. `seen` flips to true when the user views their
// badges list, used to drive the "new badge" notification dot.
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  badgeId  String   @map("badge_id") @db.VarChar(60)
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)
  seen     Boolean  @default(false)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ── Social Feed ───────────────────────────────────────────────

// Explicit social graph — who follows whom.
model Follow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ── Unified rating / feed model ───────────────────
// Shipped via the rewire phases 1, 1.5, 2, 3, 4 (2026-05). The legacy
// `Checkin*` tables were dropped in phase 4 (migration
// `20260516125827_rewire_phase4_drop_checkins`). Design rationale:
// docs/dev/proposals/rewire.md.

// Lookup table that constrains (wines.category, wines.style) to a known set.
// Soft-deletable (`active=false`) because dropping a style row would break
// FKs from existing wines. UI dropdowns filter on active=true.
// Declared drink-category vocabulary, and the FK target for `wines.category` /
// `wine_products.category`.
//
// 🔒 It exists because the composite `(category, style)` FK to CategoryStyle is
// MATCH SIMPLE and `style` is nullable, so that FK skips its check entirely
// whenever a style is absent — leaving `category` accepting any string at all
// (measured: `category='spirit', style=NULL` inserted cleanly on both tables).
// CategoryStyle cannot be the target itself: its PK is the PAIR, so there is no
// row to reference for a category alone.
//
// Extending to beer/spirits: INSERT here, then the styles into CategoryStyle.
// That is an INSERT rather than a migration, which is what made this shape
// preferable to pinning `category` to a literal set.
model Category {
  category  String        @id @db.VarChar(32)
  label     String        @db.VarChar(64)
  sortOrder Int           @default(0) @map("sort_order")
  active    Boolean       @default(true)
  wines     Wine[]
  products  WineProduct[]

  @@map("categories")
}

// 🔒 ADDING A ROW HERE IS A CROSS-SIDE EVENT, not a local seed change.
//
// The catalog-maintenance side holds 6,455 rows we cannot store — 2,409
// `dessert` and 4,046 `fortified` — ingested and excluded from export *until
// this vocabulary grows*. They pin our style set, so adding `dessert` or
// `fortified` here unblocks a release on their side that must then be
// re-decided rather than inherited.
//
// ⚠️ So the ordering is OURS-THEN-THEIRS and must not be reversed: this table
// grows first, then they flip the export filter. Reversed, a deliberate release
// becomes a batch of FK violations against the composite (category, style) FK —
// and an import batch is all-or-nothing, so one row fails the whole batch.
//
// 🔒 ANNOUNCING A CHANGE HERE IS THE PRIMARY MECHANISM. NOT a courtesy on top of
// automation. Nothing in THIS repo watches this table's contents (the contract
// snapshot covers constraints, not seed rows) and there is no app write path —
// it changes only by migration. And their gate's automatic half re-derives from
// a clone of this repo, so it only fires if someone has one to hand; without it
// their check cannot say anything about our vocabulary at all. (They found and
// corrected that themselves — an earlier version printed a ✅ that compared two
// of their own constants and read as a statement about us.)
//
// So: a migration adding a style passes every check here silently, and may or
// may not be caught over there. Announce it.
//
// See docs/dev/proposals/wine-catalog.md § OPEN — sequencing.
model CategoryStyle {
  category  String  @db.VarChar(32)
  style     String  @db.VarChar(64)
  label     String  @db.VarChar(64)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  wines     Wine[]
  products  WineProduct[]

  @@id([category, style])
  @@index([category, sortOrder])
  @@map("category_styles")
}

// Per-tasting photo album. Multiple photos per rating (live session AND
// standalone), distinct from the wine's canonical bottle shot
// (wines.imageUrl). Cascade on rating delete; S3 reclaim is independent
// of cascade and lives in every delete path (capture / commit / reclaim-after,
// per root CLAUDE.md cross-cutting rule).
model RatingImage {
  id        Int      @id @default(autoincrement())
  ratingId  Int      @map("rating_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ratingId, sortOrder])
  @@map("rating_images")
}

// The unified feed entry. Two kinds today: 'session' (one per (user, session)
// — wraps every rating that user made in that session) and 'standalone'
// (one per check-in — wraps a single rating). Future kinds extend the
// enum without schema changes. See rewire.md §2 for the full reasoning.
model FeedItem {
  id             Int            @id @default(autoincrement())
  // NOT NULL — anon ratings never get feed_items (§3). Forcing non-null
  // prevents accidental anon writes from reaching the table.
  userId         Int            @map("user_id")
  // 'session' | 'standalone' today. Immutable once set.
  kind           String         @db.VarChar(32)
  sessionId      Int?           @map("session_id")
  // Standalone is 1:1 with a rating; session enumerates ratings via
  // (userId, sessionId) on the ratings table — no ratingId here.
  ratingId       Int?           @unique @map("rating_id")
  venueName      String?        @map("venue_name") @db.VarChar(255)
  city           String?        @db.VarChar(100)
  country        String?        @db.Char(2)
  lat            Decimal?       @db.Decimal(9, 6)
  lng            Decimal?       @db.Decimal(9, 6)
  // false = render no location at all; true = render venue/city. Boolean,
  // not enum — the "private tasting" signal is UX copy, not data (§2).
  locationPublic Boolean        @default(false) @map("location_public")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict: hard-deleting a session must fail loudly. Soft-delete
  // (sessions.deletedAt) is the contract; the §8 tombstone preserves the
  // FK so the JOIN keeps rendering "[deleted session]" tombstones.
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Standalone is 1:1 with a rating; cascade is correct (the post is the
  // social wrapper of the rating).
  rating         Rating?        @relation(fields: [ratingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  likes          FeedItemLike[]
  tags           FeedItemTag[]

  // One feed_item per (user, session) — prevents double-creation under
  // concurrent rates via ON CONFLICT DO NOTHING (§2). NULLs are distinct
  // in Postgres unique constraints, so standalone rows (sessionId IS NULL)
  // are unconstrained — exactly what we want.
  @@unique([userId, sessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("feed_items")
}

// Likes on a feed item. Cascade matches today's checkin_likes pattern: the
// liker deleting their account drops the edge; the author keeps the post.
model FeedItemLike {
  userId     Int      @map("user_id")
  feedItemId Int      @map("feed_item_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, feedItemId])
  @@index([feedItemId])
  @@map("feed_item_likes")
}

// Tags on a feed item. Cascade matches today's checkin_tags pattern: the
// tagged user deleting their account drops the edge; the author keeps the
// post (the social signal alone goes).
model FeedItemTag {
  feedItemId Int      @map("feed_item_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([feedItemId, userId])
  @@index([userId])
  @@map("feed_item_tags")
}

// ── Staff roles ───────────────────────────────────────────────
// Account-level staff privilege. Deliberately a SEPARATE TABLE, never a column
// on `users`: a privilege bit there would sit on the hottest table in the app,
// reachable by every existing prisma.user.update AND by Better Auth's own
// writes into users — whereas this table has no existing write path at all.
// Same safe-by-construction reasoning as the lib/identityStore.ts credential
// chokepoint. (users.role is a DEAD column — @default("taster"), read by
// nothing; the heavily-used SessionMember.role is the unrelated SESSION axis.)
//
// 🔒 Resolve from a FRESH DB READ on every check — never cached into a JWT or
// session. Mirrors the never-cache-auth() invariant in lib/CLAUDE.md: any TTL
// is a window in which a revoked privilege still resolves, which is the hole
// itself. Resolver: lib/staffRole.ts.
//
// `admin` IMPLIES `curator` — the resolver answers a curator-level check
// affirmatively for an admin grant, so each person holds exactly one row.
// Values ('admin' | 'curator') are CHECK-constrained in the migration.
//
// 🔒 ROLE CHANGES ARE TRANSITIONS, NOT ACCUMULATED GRANTS — see the PK note
// below. Three rules, all enforced in lib/staffRole.ts:
//   • PROMOTION (curator → admin) replaces the row, writing revoke-curator +
//     grant-admin atomically so the audit trail shows both halves.
//   • 🔒 A DOWNGRADE IS NEVER IMPLICIT. Granting `curator` to an existing admin
//     is REJECTED, not silently applied — otherwise a routine-looking grant
//     would quietly strip admin. Lowering privilege requires the explicit
//     demote operation.
//   • REVOKING ADMIN REMOVES ALL STAFF ACCESS (Simon, 2026-07-25) — the person
//     becomes an ordinary user, NOT an automatic curator. Auto-demotion would
//     leave someone holding privileges the revoker may not have meant to leave
//     them; re-granting curator afterwards is a separate deliberate act.
model StaffRole {
  // 🔒 user_id is the PK — ONE LIVE ROLE ROW PER USER, not (user_id, role).
  // A composite key permitted a user to hold BOTH 'admin' and 'curator' at once
  // (reproduced on PG16), and because `admin` implies `curator` the fallout was
  // silent: revoking admin left the curator row behind so privilege never
  // actually dropped, and revoking curator from a dual holder was a no-op that
  // still reported success.
  userId    Int      @id @map("user_id")
  role      String   @db.VarChar(16)
  // Who granted it. SetNull (not Cascade) so revoking the granter's account
  // never silently drops live privilege; null also means "system-minted",
  // which is exactly what the direct-DB bootstrap INSERT writes (runbook in
  // prisma/CLAUDE.md) — the audit trail stays honest that no human granted the
  // first admins.
  grantedBy Int?     @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  // Cascade: deleting an account removes its live grant. History survives
  // independently in staff_role_audit, which holds ID SNAPSHOTS, not FKs.
  user      User     @relation("StaffRoleHolder", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  granter   User?    @relation("StaffRoleGranter", fields: [grantedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([role])
  @@map("staff_roles")
}

// Append-only history of privilege changes. Rows are NEVER updated or deleted
// — including when the staff_roles grant they describe is cascaded away by
// account deletion.
//
// 🔒 Subject and actor are IMMUTABLE ID SNAPSHOTS, not FKs. "Survives account
// deletion, never updated" and "plain FK to users" are incompatible: Cascade
// deletes the history, SetNull mutates a row that is supposed to be
// append-only. This is the cascade-vs-tombstone rule from root CLAUDE.md
// resolved toward NEITHER — the row is a durable record ABOUT an account, not
// a row BELONGING to one.
//
// 🔒 No display-name snapshot (ruled 2026-07-24). Privilege auditing must
// answer WHICH ACCOUNT held power, and the id answers that completely.
// Retaining a name forever would carve an exception out of account deletion,
// which elsewhere rewrites names to '[deleted]' precisely so a deleted user's
// name stops surfacing. Readers resolve current names by join; a deleted user
// shows as an unresolvable id, which is the correct outcome. The
// wines.addedByDisplayName precedent does NOT transfer — that snapshot is
// load-bearing because anonymous adders have no user row to join to, whereas
// every staff grant is by definition a registered account.
//
// Separate from catalog_audit on purpose: that records actions on CATALOG
// ENTITIES, this records changes to PRIVILEGE. Conflating them would put a
// role revocation in the same stream as a vintage merge.
model StaffRoleAudit {
  id        Int      @id @default(autoincrement())
  // ID snapshots — no relation fields, by design (see above).
  subjectId Int      @map("subject_id")
  role      String   @db.VarChar(16)
  // 'grant' | 'revoke' (CHECK in the migration).
  action    String   @db.VarChar(16)
  // Null = no authenticated human actor. Three cases, all legitimate:
  // the direct-DB bootstrap INSERT (system-minted, matching
  // staff_roles.grantedBy; runbook in prisma/CLAUDE.md), and
  // 🔒 ACCOUNT DELETION — the cascade fires inside the DB with no trustworthy
  // way to obtain the authenticated actor, so the deletion audit is written as
  // actorId = NULL with reason = 'account deletion'. That pairing is the
  // documented contract: a NULL actor with that reason means "privilege ended
  // because the account went away", never "an admin did this".
  actorId   Int?     @map("actor_id")
  reason    String?  @db.VarChar(255)
  // 🔒 SERVER-ASSIGNED, and a trigger OVERWRITES any supplied value with now().
  // Blocking UPDATE/DELETE alone still permits BACKDATED FAKE INSERTS — a
  // reviewer forged a row dated 1999 against the pre-fix schema. An audit log
  // whose timestamps a writer can choose does not establish when anything
  // happened, so the database takes the clock away from the caller.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectId, id])
  @@map("staff_role_audit")
}

// ── Wine catalog ──────────────────────────────────────────────
// The producer / product / vintage identity spine. Spec of record:
// docs/dev/proposals/wine-catalog.md; build plan:
// docs/dev/proposals/wine-catalog-implementation.md.
//
// 🔒 THE INVARIANT EVERYTHING HANGS ON: an entry is created DISTINCT.
// Combining entries is a separate, deliberate, REVERSIBLE action — a merge.
// The fuzzy match is only a SUGGESTION surfacing likely duplicates for
// confirmation; it is NEVER an automatic find-or-create hook. (This is what
// the rejected PR #82 model got wrong.)
//
// 🔒 DATA-PROVENANCE RULE (hard): never store ANY source-provenance field —
// no source URLs, slugs, source ids, or source region ids — and never expose
// source provenance on any surface. Identity is our own nanoids; refreshes
// arrive as upserts keyed on OUR ids.
//
// 🔒 The shapes of producers / wine_products / wine_vintages /
// product_producers / product_eans (plus the wines link columns above) are a
// VERSIONED INTERFACE. Any change to them is a contract change: surfaced
// explicitly and shipped with a version bump, never made silently.
//
// One ID for life: an entry keeps exactly one nanoid forever — through
// confirmation, merge, unmerge, archive. Nothing ever re-mints. That is what
// keeps every wines link safe across all future maintenance.
//
// Shared columns on all three entity tables:
//   status       'provisional' | 'confirmed' | 'linked' | 'archived' |
//                'rejected' (varchar + CHECK; house convention, no PG enums)
//   linksTo      merge tombstone pointer, nullable self-FK. Paired with
//                status by CHECK ((status='linked') = (links_to IS NOT NULL))
//                and CHECK (links_to <> id). Chains are KEPT, not flattened —
//                reads resolve transitively with a visited set + depth cap.
//   curatorLocked  text[] of field names whose NULL (or {}) is AUTHORITATIVE.
//                The import fill-null path and read-time group coalescing both
//                skip a locked field. Fill-null cannot otherwise distinguish
//                "unknown" from "a curator deliberately cleared a wrong value".
//   addedBy / curatedBy   SetNull — community catalog rows are NEVER cascaded
//                by a user deletion.
//   *Folded      GENERATED columns (raw SQL — Prisma can't express them),
//                catalog_fold_v1(...) — VERSIONED; see the note on
//                nameFolded below. ONE mandatory database-side
//                normalization path, so no write path can make display and
//                fold drift. A pg_trgm GiST index (KNN ordering) and a
//                covering B-tree (equality) go on the folded columns.

// First-class maker. "Producer" means the LABEL/BRAND IDENTITY users see and
// search for, not necessarily the legal producing house (a future label-brand
// → legal-house relationship lands additively). Generic product names
// ("Réserve", "Brut") are PRODUCER-SCOPED — they collide constantly across
// producers and must never merge across them.
model Producer {
  id            String    @id @db.VarChar(21)
  // Display form, accents preserved. nameFolded (generated, raw SQL) is the
  // matching key — one value cannot serve both jobs.
  name          String    @db.VarChar(255)
  country       String?   @db.VarChar(2)
  // Transitional string (see wine_products.region). Blank normalizes to NULL
  // at the boundary: it feeds regionFolded and joins the fold, so a blank
  // would collide with every other blank.
  region        String?   @db.VarChar(255)
  website       String?   @db.VarChar(512)
  // 🔒 READ-ONLY. Both are Postgres GENERATED ALWAYS AS (...) STORED columns —
  // catalog_fold_v1(...) — whitespace-canonicalizing, lowercase LAST because
  // some unaccent expansions produce capitals — declared as plain nullable
  // fields here ONLY
  // because Prisma has no generated-column syntax and the schema-vs-migrations
  // CI gate would otherwise report them as drift. NEVER write them: Postgres
  // rejects any INSERT/UPDATE that supplies a value, so a write is a runtime
  // error, not silent drift. The generation expression lives in the migration
  // and is the SINGLE normalization path — that is what makes display/fold
  // drift structurally impossible.
  nameFolded    String?   @default(dbgenerated("catalog_fold_v1((name)::text)")) @map("name_folded")
  regionFolded  String?   @default(dbgenerated("catalog_fold_v1((region)::text)")) @map("region_folded")
  status        String    @default("provisional") @db.VarChar(16)
  linksTo       String?   @map("links_to") @db.VarChar(21)
  curatorLocked String[]  @default([]) @map("curator_locked")
  addedBy       Int?      @map("added_by")
  curatedBy     Int?      @map("curated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // NoAction: purge resolves inbound pointers explicitly in its own transaction
  // (re-point or clear), and the FK is the backstop against a purge that forgets
  // one. ⚠️ NOT "like every catalog-referencing FK" — eight of the nine forward
  // FKs into catalog tables are NoAction; `product_producers.product_id` is the
  // SOLE intentional Cascade (see its own comment), so a product referenced only
  // by its join rows deletes successfully and cascades them.
  target        Producer? @relation("ProducerMerge", fields: [linksTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tombstones    Producer[] @relation("ProducerMerge")
  adder         User?     @relation("ProducerAdder", fields: [addedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  curator       User?     @relation("ProducerCurator", fields: [curatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products      ProductProducer[]

  @@index([status])
  @@index([linksTo])
  // COVERING B-tree for folded EQUALITY (findProducerByExactName / phase-5
  // backfill). Includes the columns the query returns so it plans as an INDEX
  // ONLY SCAN — measured 0.125 ms / 4 buffers, versus 0.544 ms / 130 buffers
  // when the planner fell back to GiST because a bare B-tree still needed a
  // heap fetch. ⚠️ Prisma has no `INCLUDE` syntax, so `status` is declared as a
  // third KEY column here while the migration makes it an INCLUDE payload —
  // the drift gate compares the column LIST, so this keeps it honest about the
  // index's existence and columns; the migration supplies the real shape.
  @@index([nameFolded, id, status], map: "producers_name_folded_idx")
  // 🔒 GiST KNN index — what add-time search actually orders by. `<->>` is
  // `1 - word_similarity`, so ranking is identical to the old GIN `<%` form,
  // but cost is bounded by the LIMIT instead of by the match count (measured
  // 22 ms → 0.26 ms on a broad query). Equality is served by the covering
  // B-tree above, NOT by a trigram index — GIN was dropped in
  // 20260725160000_catalog_gist_knn because it was 10x slower than a B-tree
  // for `=` at 3x the size, and nothing issues a containment query.
  @@index([nameFolded(ops: raw("gist_trgm_ops"))], type: Gist, map: "producers_name_folded_gist_idx")
  @@map("producers")
}

// The product — groups vintages. The PRIMARY MERGEABLE ENTITY.
model WineProduct {
  id            String    @id @db.VarChar(21)
  name          String    @db.VarChar(255)
  category      String    @default("wine") @db.VarChar(32)
  // Composite FK (category, style) → category_styles, like wines. Nullable;
  // the FK enforces only when both are non-null (MATCH SIMPLE). Values
  // red/white/rosé/spark; 'nonalc' is TRANSITIONAL — supported for v1
  // compatibility but not locked as permanent style identity, since
  // ABV/alcohol attributes are the intended direction. dessert/fortified
  // deferred.
  style         String?   @db.VarChar(64)
  // ⚠️ Prisma Decimal serializes to a JSON STRING ("13.50"), not a number.
  // EVERY API response surfacing this must coerce via Number() — the
  // wire-format trap in root CLAUDE.md.
  abv           Decimal?  @db.Decimal(4, 2)
  // 🔒 NON-NULL, default {} — and {} means "no grapes recorded", so {} IS
  // ENRICHABLE. Prisma cannot model an optional scalar list ("Optional lists
  // are not supported"), so {} is the SOLE representation of unrecorded and
  // there is no known-empty state in v1. Consequence: arrays need their own
  // missingness rule — the scalar COALESCE(existing, incoming) fill would
  // freeze every grape-less row FOREVER (for a non-null column `existing` is
  // never null, so COALESCE always returns it, silently). Arrays fill on
  // cardinality(existing) = 0; scalars keep the strict IS NULL rule. A
  // DELIBERATE empty becomes authoritative only via curatorLocked — that lock
  // is the only mechanism available for arrays. If known-empty ever becomes
  // load-bearing, the additive fix is a `grapesKnown` flag alongside.
  grapes        String[]  @default([])
  // Optional override of the producer's region. Transitional string, like
  // producers.region: the final design is first-class Verre-owned entities —
  // a region tree (country → region → subregion → appellation) and a
  // grape-variety tree (descendants, synonyms) — landing ADDITIVELY as new
  // tables without changing any producer/product/vintage ID. No source-side
  // structured identifiers are persisted to build from (provenance rule); the
  // trees are built later against Verre identity.
  region        String?   @db.VarChar(255)
  // 🔒 READ-ONLY generated columns — see the Producer note above. grapesFolded
  // folds element-wise through catalog_fold_arr_v1, which is STRICT + COALESCEs
  // array_agg so {} folds to {} rather than NULL (array_agg over zero rows
  // returns NULL) — empty must stay distinguishable from unknown.
  nameFolded    String?   @default(dbgenerated("catalog_fold_v1((name)::text)")) @map("name_folded")
  regionFolded  String?   @default(dbgenerated("catalog_fold_v1((region)::text)")) @map("region_folded")
  grapesFolded  String[]  @default(dbgenerated("catalog_fold_arr_v1(grapes)")) @map("grapes_folded")
  // 'shared' | 'owned'. Reserved for the DEFERRED ownership axis.
  // 🔒 NO DEFAULT, deliberately. Every write boundary sets this EXPLICITLY, so
  // an omitted scope FAILS LOUDLY (NOT NULL violation) instead of silently
  // landing 'shared' — i.e. PUBLIC. A default here would mean a future `owned`
  // entry leaks to the public catalog because a caller forgot a field, which is
  // the one failure mode this column exists to prevent. The table is new, so
  // there is no populated-row argument for keeping a default.
  scope         String    @db.VarChar(16)
  status        String    @default("provisional") @db.VarChar(16)
  linksTo       String?   @map("links_to") @db.VarChar(21)
  curatorLocked String[]  @default([]) @map("curator_locked")
  addedBy       Int?      @map("added_by")
  curatedBy     Int?      @map("curated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  target        WineProduct?  @relation("ProductMerge", fields: [linksTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tombstones    WineProduct[] @relation("ProductMerge")
  adder         User?     @relation("ProductAdder", fields: [addedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  curator       User?     @relation("ProductCurator", fields: [curatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  categoryStyle CategoryStyle? @relation(fields: [category, style], references: [category, style], onDelete: NoAction, onUpdate: NoAction)
  // See the matching field on Wine: the composite FK is MATCH SIMPLE and does
  // not fire when `style` is null, so this is what constrains `category`.
  categoryRef   Category       @relation(fields: [category], references: [category], onDelete: NoAction, onUpdate: NoAction)
  producers     ProductProducer[]
  vintages      WineVintage[]
  eans          ProductEan[]
  wines         Wine[]

  @@index([status])
  @@index([linksTo])
  // Covering B-tree for folded equality — see the producers note above.
  @@index([nameFolded, id, status], map: "wine_products_name_folded_idx")
  // GiST KNN — see the producers note above.
  @@index([nameFolded(ops: raw("gist_trgm_ops"))], type: Gist, map: "wine_products_name_folded_gist_idx")
  @@map("wine_products")
}

// Product ↔ producer, many-to-many, with role.
//
// 🔒 EVERY PRODUCT HAS EXACTLY ONE `lead` (plus 0..n collaborators). That takes
// THREE separate pieces, and the third is the one that gets skipped because
// the partial unique index LOOKS like it covers the whole thing:
//
//   1. AT MOST ONE — partial unique on (product_id) WHERE role = 'lead'. The
//      composite PK does NOT substitute (verified: it blocks duplicate PAIRS
//      while happily allowing two different producers both marked lead).
//   2. AT LEAST ONE AT CREATION — a deferred constraint trigger on
//      wine_products checks at COMMIT that a lead link exists.
//   3. AT LEAST ONE OVER TIME — deleting the sole lead OR DEMOTING it
//      lead → collaborator leaves zero leads. The demotion path is the easy
//      one to miss: nothing is deleted, so a delete-focused guard never fires.
//
// Pieces 2 and 3 are NOT declaratively expressible ("at least one child row
// exists" is not a CHECK — no CHECK can see other rows), so they are
// INITIALLY DEFERRED constraint triggers (chosen over a write-path helper at
// the phase-1 review gate, 2026-07-24: only the trigger route lets the
// invariant be claimed as DATABASE-enforced, unbypassable including by a
// future path nobody remembered). Deferral is mandatory — an IMMEDIATE
// trigger fires on the delete/demote and blocks the legitimate swap before
// the replacement lands.
//
// ⚠️ TWO ORDERING TRAPS, both verified against PG16:
//   • The prohibition is on separate TRANSACTIONS, not statement order. With
//     the immediate partial unique, promoting the new lead FIRST fails — the
//     old lead still exists. So within one transaction: remove or demote the
//     old lead FIRST, then insert or promote.
//   • REPLACEMENT IS NOT ALWAYS AN INSERT. If the incoming lead is already a
//     collaborator on that product — the common promotion case — inserting a
//     second (product_id, producer_id) row fails the composite PK. It must be
//     an UPDATE … SET role = 'lead'. A replace path that only ever inserts is
//     broken for exactly the case most likely to occur.
//
// The single-producer case is simply lead-with-no-collaborators. A
// collaboration is ONE product with 2+ links, set at creation — NOT a merge.
//
// ⚠️ CLIENT-LEVEL CONSEQUENCE, stated bluntly because phase-2 authors will
// otherwise meet it as a confusing runtime error: a bare
// `prisma.wineProduct.create()` can NEVER succeed — the creation trigger raises
// `has no lead producer` at COMMIT. A product and its lead link must commit in
// ONE $transaction. That is the invariant working, not a bug.
model ProductProducer {
  productId  String      @map("product_id") @db.VarChar(21)
  producerId String      @map("producer_id") @db.VarChar(21)
  // 'lead' | 'collaborator' (CHECK in the migration).
  role       String      @db.VarChar(16)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  // Cascade from the product: a purge deletes the product's join rows as part
  // of its own transaction, and the deferred lead trigger carves out the case
  // where the parent product is gone (otherwise the invariant would block its
  // own cleanup path). Producer side is NoAction — a producer purge is only
  // valid once no join row references it.
  product    WineProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  producer   Producer    @relation(fields: [producerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, producerId])
  @@index([producerId])
  @@map("product_producers")
}

// The rating grain.
model WineVintage {
  id            String    @id @db.VarChar(21)
  productId     String    @map("product_id") @db.VarChar(21)
  // 🔒 year = null means THE NON-VINTAGE INSTANCE EXCLUSIVELY — never "year
  // unknown". An unknown-year rating links at PRODUCT level instead
  // (wines.vintageId null), so NV rows stay clean.
  year          Int?
  // Per-vintage override of the product ABV. Same Decimal wire-format trap.
  abv           Decimal?  @db.Decimal(4, 2)
  // Per-vintage override of the product's grapes — blend proportions shift year
  // to year, and a producer may drop a variety outright in a difficult vintage.
  //
  // 🔒 THE FLAG IS LOAD-BEARING; `grapes` alone cannot carry the meaning:
  //   override=false, grapes={}   → INHERIT wine_products.grapes
  //   override=true,  grapes={}   → this vintage genuinely has none listed
  //   override=true,  grapes=[…]  → this vintage's own composition
  // A CHECK forbids the fourth (false + non-empty) combination, so a hidden
  // override cannot sit unread behind a false flag.
  //
  // ⚠️ A NULLABLE ARRAY CANNOT EXPRESS THIS, and the first draft tried. It used
  // NULL=inherit and `{}`=none; Postgres held them apart but **Prisma returns
  // `[]` for BOTH**, so the two states were indistinguishable to every
  // application read path. Measured against the generated client, not assumed.
  // Same toolchain limitation as the non-null rule on wine_products.grapes:
  // Prisma cannot model an optional scalar list.
  //
  // Effective value: CASE WHEN grapesOverride THEN vintage.grapes ELSE
  // product.grapes END — never COALESCE, which would silently turn "genuinely
  // none" back into inheritance, since `{}` is not NULL.
  //
  // 🔒 NOT the product's missingness rule: at PRODUCT grain `{}` means "not
  // recorded" and IS enrichable by import; here `{}` under a true flag is an
  // assertion import must not fill.
  grapes         String[] @default([])
  grapesOverride Boolean  @default(false) @map("grapes_override")
  // 🔒 NO `grapesFolded` here, unlike wine_products: a folded column exists to
  // be MATCHED, and discovery/search only ever touches producer and product —
  // a vintage is SELECTED from the product view, never searched.
  status        String    @default("provisional") @db.VarChar(16)
  linksTo       String?   @map("links_to") @db.VarChar(21)
  curatorLocked String[]  @default([]) @map("curator_locked")
  addedBy       Int?      @map("added_by")
  curatedBy     Int?      @map("curated_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // NoAction (not Cascade): a product purge must purge its vintages FIRST and
  // explicitly. This FK forces that ordering rather than silently taking the
  // children with it.
  product       WineProduct  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target        WineVintage? @relation("VintageMerge", fields: [linksTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tombstones    WineVintage[] @relation("VintageMerge")
  adder         User?     @relation("VintageAdder", fields: [addedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  curator       User?     @relation("VintageCurator", fields: [curatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  wines         Wine[]

  // Redundant with the PK, but it is what makes the composite FK from
  // wines (vintage_id, product_id) legal — that FK is the structural
  // guarantee that a chosen vintage belongs to the stored product.
  @@unique([id, productId])
  // ⚠️ THE DECLARATION HERE IS WEAKER THAN THE CONSTRAINT THAT SHIPS. The real
  // rule — one row per year AND ONE NV ROW PER PRODUCT — is
  // UNIQUE NULLS NOT DISTINCT (product_id, year), which is written in the
  // migration's raw half. Prisma has no syntax for NULLS NOT DISTINCT, so this
  // @@unique exists to keep the schema-vs-migrations CI gate honest about the
  // constraint's EXISTENCE, and the migration supplies its actual strength.
  // Taken literally, this line would permit MULTIPLE null-year rows (Postgres
  // treats NULLs as distinct by default) — i.e. unlimited duplicate NV rows on
  // one product. The database does not permit that. Read the migration, not
  // this line, for the semantics.
  @@unique([productId, year], map: "wine_vintages_product_year_key")
  // No separate @@index([productId, year]) — the unique above already creates a
  // btree on exactly those columns in that order, so a plain index would be
  // pure write-amplification on a table the docs expect to be large. (Verified:
  // both appeared in pg_indexes with identical column lists.)
  @@index([status])
  @@index([linksTo])
  @@map("wine_vintages")
}

// Barcodes, PRODUCT-GRAIN. Part of the import interface.
//
// 🔒 An EAN already assigned to ANOTHER product is a conflict/review event —
// NEVER an automatic reassignment. This is the RFC's "false merges are the
// expensive failure" principle applied to strong identifiers: a shared EAN
// RAISES match confidence at suggestion time, it never silently moves a
// barcode between products.
//
// Confidence itself is app-side and NOT part of the import interface — the
// interface carries the barcode as a fact, not a score.
model ProductEan {
  // 🔒 STRING, not a numeric type — a numeric corrupts 0-prefixed EAN-13s by
  // dropping the leading zero. Canonicalized on write; the GTIN check digit is
  // enforced by a DATABASE CHECK (`product_eans_check_digit`, calling
  // `gtin_check_digit_ok`) alongside the exact-length rule — length alone does
  // NOT catch a plausible-length code with a wrong final digit.
  ean       String      @id @db.VarChar(14)
  productId String      @map("product_id") @db.VarChar(21)
  // 🔒 WRITE-ONCE: set on insert, never updated. This is the "when did this
  // barcode first reach us" fact; a fill-null rule would leave it correct only
  // by accident.
  firstSeen DateTime    @default(now()) @map("first_seen") @db.Timestamptz(6)
  // 🔒 MONOTONIC, and EXPLICITLY EXEMPT from the fill-null rule. Under
  // fill-null-only a non-null lastSeen would never advance, freezing at first
  // sight — so it is updated explicitly, and only ever FORWARD
  // (GREATEST(existing, incoming)).
  lastSeen  DateTime    @default(now()) @map("last_seen") @db.Timestamptz(6)
  product   WineProduct @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId])
  @@map("product_eans")
}

// App-only bookkeeping of catalog lifecycle actions — merge, unmerge, confirm,
// reject, archive, lock-field, purge. NOT part of the import interface.
//
// 🔒 Written IN THE SAME TRANSACTION as the status/pointer update it records,
// so a partial write can never produce an unreadable tombstone and repeated
// merge/unmerge cycles are always reconstructible.
//
// priorStatus is what makes unmerge correct: clearing linksTo is one row
// update, but it must also choose the RESTORED lifecycle state — a pre-merge
// `provisional` must not come back `confirmed`.
//
// Actor is an ID SNAPSHOT with no FK, for the same append-only reason as
// staff_role_audit. entityId/targetId are likewise snapshots, not FKs: a
// hard-purged entity must not take its own purge record with it.
model CatalogAudit {
  id          Int      @id @default(autoincrement())
  // 'producer' | 'product' | 'vintage' (CHECK in the migration).
  entityType  String   @map("entity_type") @db.VarChar(16)
  // The subject — for a merge, the LOSER.
  entityId    String   @map("entity_id") @db.VarChar(21)
  // The merge target. Null for every non-merge action.
  targetId    String?  @map("target_id") @db.VarChar(21)
  // 'merge' | 'unmerge' | 'confirm' | 'reject' | 'archive' | 'lock_field' |
  // 'unlock_field' | 'purge' | 'edit' (CHECK in the migration).
  action      String   @db.VarChar(24)
  priorStatus String?  @map("prior_status") @db.VarChar(16)
  actorId     Int?     @map("actor_id")
  reason      String?  @db.VarChar(255)
  // 🔒 Server-assigned; a trigger overwrites any supplied value with now(),
  // and UPDATE/DELETE are blocked — same append-only regime as
  // staff_role_audit, for the same reason.
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, id])
  @@index([createdAt(sort: Desc)])
  @@map("catalog_audit")
}

