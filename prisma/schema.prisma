generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // unaccent powers accent-insensitive moments search (GET /api/me/sessions
  // ?q); pg_trgm adds the typo-tolerant word_similarity fallback. The
  // f_unaccent() IMMUTABLE wrapper + any functional trgm index live in raw
  // migration SQL (Prisma's datamodel can't express a function or an
  // expression index; migrate diff ignores both, so no schema drift).
  extensions = [pg_trgm, unaccent]
}

model User {
  id                        Int                    @id @default(autoincrement())
  name                      String                 @db.VarChar(64)
  email                     String                 @unique @db.VarChar(255)
  // Nullable since native auth (Better Auth): a social-only user (Google/Apple)
  // has NO password — Better Auth inserts a users row writing name/email/
  // timestamps but never password_hash (credentials live in auth_accounts).
  // NOT NULL would 500 the first social sign-up. Every bcrypt.compare consumer
  // MUST guard the null hash before comparing (auth.ts feeds ?? DUMMY_HASH;
  // account PATCH/DELETE + lib/verifyPassword guard explicitly). See
  // docs/dev/proposals/mobile-app/01-identity-and-auth.md §4.
  passwordHash              String?                @map("password_hash") @db.VarChar(255)
  // Additive columns Better Auth requires on its `user` model (mapped onto this
  // table). Both defaulted → additive-safe on the populated table; NextAuth
  // ignores them. updated_at is @default(now()) WITHOUT @updatedAt: Better Auth
  // manages it in its own writes, and leaving Prisma's auto-bump off keeps the
  // dual-store decoupled (no race between BA's explicit set and a Prisma bump on
  // every existing prisma.user.update). See proposal §4.
  emailVerified             Boolean                @default(false) @map("email_verified")
  updatedAt                 DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  role                      String                 @default("taster") @db.VarChar(16)
  pro                       Boolean                @default(false)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  // XP from rating wines, hosting sessions, etc. — separate from lifetime_*
  // because XP is a sum of weighted action points, not a count of actions.
  xp                        Int                    @default(0)
  tokenVersion              Int                    @default(0) @map("token_version")
  // Snapshot counters — monotonic, never decrement. Drive badge progression
  // and shield user achievement state from rating deletions (e.g. when a
  // host deletes a session that contained the user's ratings).
  lifetimeRatings           Int                    @default(0) @map("lifetime_ratings")
  lifetimeFiveStar          Int                    @default(0) @map("lifetime_five_star")
  lifetimeOneStar           Int                    @default(0) @map("lifetime_one_star")
  lifetimeNotesWritten      Int                    @default(0) @map("lifetime_notes_written")
  lifetimeMaxNoteLength     Int                    @default(0) @map("lifetime_max_note_len")
  lifetimeSessionsJoined    Int                    @default(0) @map("lifetime_sessions_joined")
  lifetimeSessionsHosted    Int                    @default(0) @map("lifetime_sessions_hosted")
  lifetimePhotosAdded       Int                    @default(0) @map("lifetime_photos_added")
  lifetimeConsecutiveMonths Int                    @default(0) @map("lifetime_consecutive_months")
  firstRatedAt              DateTime?              @map("first_rated_at") @db.Timestamp(6)
  imageUrl                  String?                @map("image_url") @db.VarChar(512)
  // Profile visibility — see lib/profileVisibility.ts. Stored as VARCHAR(32)
  // (not a Postgres enum) so a future tier ('private', etc.) is a code-only
  // change. A CHECK constraint is hand-added in the migration; the lib-side
  // union type in ProfileVisibility is the authoritative source of truth.
  profileVisibility         String                 @default("public-users") @map("profile_visibility") @db.VarChar(32)
  visibilityFof             Boolean                @default(false) @map("visibility_fof")
  bookmarks                 Bookmark[]
  hofEntries                HallOfFame[]
  ratings                   Rating[]
  members                   SessionMember[]
  hostedSessions            Session[]
  earnedBadges              UserBadge[]
  followers                 Follow[]               @relation("UserFollowing")
  following                 Follow[]               @relation("UserFollowers")
  visibilityLog             ProfileVisibilityLog[]
  mutes                     UserMute[]             @relation("UserMuter")
  mutedBy                   UserMute[]             @relation("UserMuted")
  blocks                    UserBlock[]            @relation("UserBlocker")
  blockedBy                 UserBlock[]            @relation("UserBlocked")
  feedItems                 FeedItem[]
  feedItemLikes             FeedItemLike[]
  feedItemTags              FeedItemTag[]
  userSessions              UserSession[]
  authAccounts              AuthAccount[]
  authSessions              AuthSession[]

  // pg_trgm GIN index for fast substring search in /api/users/search.
  // The `raw("gin_trgm_ops")` operator class is what makes ILIKE queries
  // index-eligible; without it the index would only support the default
  // tsvector lookups.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

// Audit trail of every profile_visibility / visibility_fof change. Internal
// only — no API surface, no UI. Forensic safety net for dispute resolution
// ("my profile was public yesterday") and incident response. Tombstones on
// user delete (user_id → NULL) so the audit trail survives account
// deletion; rows themselves are never auto-purged.
model ProfileVisibilityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromTier  String?  @map("from_tier") @db.VarChar(32)
  toTier    String   @map("to_tier") @db.VarChar(32)
  fromFof   Boolean? @map("from_fof")
  toFof     Boolean? @map("to_fof")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([userId, changedAt])
  @@map("profile_visibility_log")
}

// One row per active credential login (the "Connected devices" feature). The
// signed JWT carries this row's `id`; the auth.ts jwt() revalidation callback
// looks up `revokedAt` on every authenticated request, so per-device sign-out
// and revoke-on-password-change become a single UPDATE. Replaces the never-
// written `users.tokenVersion` revocation mechanism (column kept in v1, dropped
// in v1.1). See docs/dev/proposals/auth-sessions.md.
model UserSession {
  // uuid v4 ONLY (NOT v7). The id is baked into the signed JWT; v4's 122 bits
  // of randomness keep it unguessable even under a hypothetical AUTH_SECRET
  // leak. v7 would leak creation time + reduce tail randomness. gen_random_uuid()
  // (what @default(uuid()) resolves to) is v4.
  id          String    @id @default(uuid()) @db.Uuid
  userId      Int       @map("user_id")
  // Derived labels parsed at authorize() time — raw User-Agent and raw IP are
  // NEVER persisted (privacy minimisation, see proposal §4). deviceLabel from
  // lib/userAgent.ts; geoLabel is country-only from lib/geo.ts (null on miss).
  deviceLabel String?   @map("device_label") @db.VarChar(64)
  geoLabel    String?   @map("geo_label") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Bumped at coarse 5-min wall-clock buckets by the jwt() revalidation branch.
  // Self-only field: queryable only via WHERE userId = $self. No analytics /
  // other-user / aggregate surface (proposal §10).
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Why the session was revoked, set alongside revokedAt. Lets the login page
  // show a tailored message (e.g. "your password was changed") when a device
  // whose session was killed by a password change next hits the app. Values:
  // 'password_change' | 'manual' | 'revoke_all' | 'logout'. Null when active.
  revocationReason String? @map("revocation_reason") @db.VarChar(32)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ── Better Auth (native-app auth) ─────────────────────────────
// Hand-authored through Verre's gated Prisma pipeline — the Better Auth CLI
// must NEVER own/migrate these (or `users`). Table names are PINNED to avoid
// collision with the existing @@map("sessions") (wine sessions) + user_sessions.
// PKs are Int autoincrement on all 3 tables (generateId:"serial" — see the
// AuthAccount comment below for why no other id mode works). `user_id` is the
// Int FK → users.id, onDelete: Cascade matching user_sessions so the raw
// `DELETE FROM users` in lib/accountDelete.ts doesn't 500 once a user has
// Better Auth rows.
// See docs/dev/proposals/mobile-app/01-identity-and-auth.md §4–§6.
//
// String columns are intentionally bare String (→ Postgres TEXT), NOT @db.VarChar
// — these are Better-Auth-owned shapes (ids/tokens it generates, OAuth tokens it
// stores). Capping them risks silent truncation if BA ever emits a longer value.
// This deliberately diverges from the schema's otherwise cap-everything convention.

// Credentials + linked social identities. providerId='credential' rows hold the
// bcrypt password hash (lazily backfilled from users.password_hash on first
// native login); providerId='google'/'apple' rows are linked social accounts.
//
// Int-serial PKs on all 3 auth tables: Better Auth 1.6.15 round-trips Int FKs
// (users.id → user_id) ONLY under generateId:"serial", which is global — it
// forces Int autoincrement ids on every BA table. Mixed-id (String PKs here,
// Int users.id) is NOT supported: the adapter stringifies ids on output unless
// serial mode is on, so the FK write fails (GH #3450; verified against the
// 1.6.15 adapter source). See proposal §4.
model AuthAccount {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

// Opaque Better Auth sessions. ⚠️ This table is NOT the source of truth on its
// own: with secondaryStorage configured (lib/betterAuth.ts), BA writes sessions
// to BOTH this table and Redis and serves reads Redis-FIRST — so deleting a row
// here does NOT revoke (the Redis copy stays live until TTL). Every revocation
// must go through Better Auth — lib/identityStore.ts's internalAdapter legs —
// which deletes both stores. `token` is the opaque session token looked up per
// request (unique). ipAddress/userAgent hold DERIVED LABELS (country name,
// "OS · Browser"), never raw values — a session.create.before hook in
// lib/betterAuth.ts converts at write time (privacy parity with user_sessions).
model AuthSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("auth_sessions")
}

// Short-lived verification tokens (email verification, etc.). Keyed on
// `identifier` (e.g. an email), NOT a user_id — so no FK / cascade here.
model AuthVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verifications")
}

// Per-pair soft-hide. A mutes B → A no longer sees B's content in
// A's feed. B is unaware. Independent of follow state; doesn't gate
// direct profile reads, search, likes, tags, or sessions.
model UserMute {
  muterId   Int      @map("muter_id")
  mutedId   Int      @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  muter     User     @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  muted     User     @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([muterId, mutedId])
  @@index([mutedId])
  @@map("user_mutes")
}

// Per-pair block. Stronger than mute: A blocks B → bidirectional
// invisibility OUTSIDE shared sessions. Profile reads, feed, search,
// follower/following lists & counts, like counts, tag rendering all
// hide the pair edge globally for everyone (Instagram-style). INSIDE
// a shared session the block goes dormant: render-style only, no
// row hiding, no identity-map mutation. Outside-session links from
// session contexts (e.g. tapping a participant's name → /u/<id>) hit
// the outside-session gate again.
//
// Block is non-destructive: follows, mutes, likes, tags between the
// pair stay in DB. Unblock restores visibility everywhere.
//
// Separate from Kick/Ban (per-session moderation primitive).
model UserBlock {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Session {
  id          Int        @id @default(autoincrement())
  // Every column except `id` and `deletedAt` is nullable: phase 2 soft-delete
  // scrubs them to NULL per the §8 data-survival contract. Unique on `code`
  // still works — Postgres treats multiple NULLs as distinct.
  code        String?    @unique @db.VarChar(16)
  hostUserId  Int?       @map("host_user_id")
  hostName    String?    @map("host_name") @db.VarChar(64)
  blind            Boolean?
  blindForEveryone Boolean?  @map("blind_for_everyone")
  createdAt   DateTime?  @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime?  @default(now()) @map("archived_at") @db.Timestamptz(6)
  name        String?    @db.VarChar(255)
  address     String?    @db.VarChar(255)
  dateFrom    DateTime?  @map("date_from") @db.Timestamptz(6)
  dateTo      DateTime?  @map("date_to") @db.Timestamptz(6)
  timezone    String?    @db.VarChar(64)
  description String?
  link        String?    @db.VarChar(512)
  // Host-chosen cover photo (S3 URL, sessions/{code}_{ts}.{ext}). Deliberately
  // NOT blind-redacted — it brands the moment, not a wine. S3 bytes are
  // reclaimed in every deletion path (capture/commit/reclaim-after).
  coverPhotoUrl String? @map("cover_photo_url") @db.VarChar(512)
  // Session-level category — the future contract for what impressions can be
  // added ('wine' → wines only) and the category vocabulary. Plain varchar
  // like wines.category (the category_styles lookup PK is the composite
  // (category, style), so no single-column FK). v1 allow-list: 'wine'.
  // Nullable for the soft-delete scrub contract; create writes 'wine'.
  category    String?    @db.VarChar(32)
  // Soft-delete tombstone marker. NULL = live; non-null = deleted at this
  // instant, with every other column scrubbed to NULL per the §8 data-survival
  // contract in docs/dev/proposals/rewire.md. The row itself stays so
  // `ratings.session_id` and `feed_items.session_id` keep their grouping
  // signal; renderers JOIN sessions to display "[deleted session]".
  // Partial index `sessions_live_idx` (added in migration SQL) makes the
  // dominant `WHERE deleted_at IS NULL` filter selective.
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  host        User?      @relation(fields: [hostUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wines       Wine[]
  ratings     Rating[]
  feedItems   FeedItem[]

  @@map("sessions")
}

model Wine {
  // Widened to VarChar(21) for standard 21-char nanoid generation (replacing
  // Date.now().toString() which collided under concurrent inserts). Existing
  // rows keep their shorter timestamp-string ids — they still fit.
  id                 String         @id @db.VarChar(21)
  // Nullable so wines can be retained when their session is deleted —
  // bookmarked wines stay reachable from the bookmark page even after the
  // hosting session is gone. Wines with sessionId=NULL are orphans.
  sessionId          Int?           @map("session_id")
  name               String         @db.VarChar(255)
  producer           String?        @db.VarChar(255)
  vintage            String?        @db.Char(4)
  grape              String?        @db.VarChar(255)
  category           String         @default("wine") @db.VarChar(32)
  style              String?        @db.VarChar(64)
  imageUrl           String?        @map("image_url")
  purchaseUrl        String?        @map("purchase_url") @db.VarChar(1000)
  description        String?        @db.VarChar(1000)
  region             String?        @db.VarChar(255)
  country            String?        @db.VarChar(2)
  vinification       String?        @db.VarChar(1000)
  revealedAt         DateTime?      @map("revealed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // Identity-id of the user or anon who added this wine. Used by kick/ban
  // to identify which wines a host can choose to orphan when removing a
  // participant. Nullable for existing rows (provenance unknown) — those
  // never match a ban-target filter and stay untouched.
  addedByIdentityId  String?        @map("added_by_identity_id") @db.VarChar(64)
  // Snapshot of the adder's display name. Frozen on ordinary edits.
  // EXCEPTION: a host/cohost "change who brought it" reassignment (ownership-
  // only PATCH /wines/[wineId] broughtByIdentityId) rewrites this and
  // added_by_identity_id to the new owner. The live identities map is preferred
  // at read time; this is a fallback for when the adder has been kicked/banned
  // (logged-in users fall through to users.name first; anon adders rely on this
  // snapshot since there's no users row).
  addedByDisplayName String?        @map("added_by_display_name") @db.VarChar(64)
  bookmarks          Bookmark[]
  ratings            Rating[]
  session            Session?       @relation(fields: [sessionId], references: [id], onUpdate: NoAction)
  // Composite FK to category_styles guarantees (category, style) is a valid
  // pair. Style is nullable; the FK only enforces when both columns are
  // non-null (Postgres default MATCH SIMPLE). Pre-flight confirmed every
  // existing row has a canonical pair; no backfill needed.
  categoryStyle      CategoryStyle? @relation(fields: [category, style], references: [category, style], onDelete: NoAction, onUpdate: NoAction)

  @@index([sessionId, addedByIdentityId])
  // pg_trgm GIN indexes for the future Tastes-tab search/filter on wine name
  // + producer. Adding now is cheap and avoids a post-import rebuild on a
  // larger table later. `raw("gin_trgm_ops")` makes ILIKE queries
  // index-eligible (the default would only support tsvector lookups).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([producer(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("wines")
}

model Rating {
  id        Int           @id @default(autoincrement())
  wineId    String        @map("wine_id") @db.VarChar(21)
  userId    Int?          @map("user_id")
  // NEW (phase 1): direct FK to the originating session. NULL for standalone
  // ratings; non-null for in-session ratings. Backfilled in this phase's
  // migration from wines.session_id. Survives session-delete because the
  // sessions row is soft-deleted (§8 contract).
  sessionId Int?          @map("session_id")
  // NEW (phase 1): provenance tag — how the rating came into being.
  // 'session' | 'standalone' today; future: 'imported', 'restaurant_api',
  // 'bottle_scan', etc. Immutable once set. Distinct from session-membership
  // (sessionId) — see rewire.md §2 for the why.
  origin    String        @db.VarChar(32)
  raterName String        @map("rater_name") @db.VarChar(64)
  // Decimal(3,2) accepts 0.00 through 5.00 in 0.25 increments.
  // Stored as numeric so AVG / GREATEST / range comparisons work
  // directly in SQL. Validation enforces the 0.25-step constraint at
  // the route layer (lib/checkinValidation.ts).
  // Nullable since phase 1.5: a chips-only or notes-only rating row
  // has no score, distinct from `score = 0` ("not rated"). See
  // rewire.md §3 (engagement rule) and §2 score-nullable reasoning.
  score     Decimal?      @db.Decimal(3, 2)
  flavors   Json          @default("{}")
  // Aroma descriptor selections — array of {a: nodeId, m: modifierId|null,
  // p?: true} entries from the @verre/core taxonomy (`p` = pronounced,
  // present only when true; re-keyed from `d` 2026-07-10 while zero rows
  // carried it — comment-only change, no migration). Capped + gated at the
  // write boundary (lib/aromas.ts gateAromas). The node may sit at any tier
  // (leaf "strawberry", subfamily "fruity.berry", family "fruity" — the
  // stored grain encodes the taster's confidence; any-tier ruling
  // 2026-07-08). '[]' is the empty signal the engagement cascade matches
  // alongside flavors = '{}'. Tier roll-ups derive from the taxonomy at
  // read time, never stored. See docs/dev/proposals/aroma/aroma-layer.md §4.
  aromas    Json          @default("[]")
  notes     String?
  ratedAt   DateTime      @map("rated_at") @db.Timestamptz(6)
  // Restrict matches the §2 design: hard-deleting a referenced session
  // should fail loudly. Soft-delete (sessions.deletedAt) is the contract;
  // any future GDPR purge must null this FK explicitly first.
  session   Session?      @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user      User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wine      Wine          @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  images    RatingImage[]
  feedItem  FeedItem?

  // Phase 1.5 dropped @@unique([wineId, userId]) in favour of a raw
  // partial unique on (user_id, wine_id, session_id) WHERE session_id
  // IS NOT NULL AND user_id IS NOT NULL — declared in the migration
  // because Prisma can't express partial uniques in schema.prisma.
  // Standalone ratings (session_id IS NULL) are intentionally
  // unconstrained: a user can have multiple standalone tastings of
  // the same wine over time (rewire.md §2).
  @@index([userId])
  @@index([sessionId])
  @@index([userId, wineId])
  @@index([userId, sessionId])
  @@map("ratings")
}

model SessionMember {
  userId      Int      @map("user_id")
  sessionCode String   @map("session_code") @db.VarChar(16)
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  role        String   @default("taster") @db.VarChar(16)
  // Durable kick-state mirror of the Redis `s:<C>:kicked` set (which expires
  // with the session). NULL = active member; 'kicked' = kick-KEEP (the row
  // survives per docs/dev/kick-ban.md, but the user is out). Written by the
  // kick path (lib/sessionWipe.ts) and cleared on rejoin (join route); kick-
  // delete/ban DELETE the row so they never carry it. Lets /api/me/sessions
  // exclude kicked moments in SQL — exact counts + lists without a per-row
  // Redis SISMEMBER. A slice of the durable-sessions workstream (Postgres-
  // authoritative moderation state).
  removedState String? @map("removed_state") @db.VarChar(16)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // No FK to Session — session_code links to Redis; Postgres session row may not exist yet

  @@id([userId, sessionCode])
  // The composite PK can't serve a filter/join on the non-leading
  // session_code column. The feed network self-join and /me/sessions both
  // join on session_code; without this index they degrade to seq scans.
  @@index([sessionCode])
  @@map("session_members")
}

model Bookmark {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  wineId  String   @map("wine_id") @db.VarChar(21)
  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  wine    Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, wineId])
  @@map("bookmarks")
}

model HallOfFame {
  id          Int      @id @default(autoincrement())
  wineName    String   @map("wine_name") @db.VarChar(255)
  producer    String?  @db.VarChar(255)
  vintage     String?  @db.Char(4)
  category    String   @default("wine") @db.VarChar(32)
  style       String?  @db.VarChar(64)
  // Quarter-stars: 0.00 through 5.00 in 0.25 steps. HoF entries are
  // currently created only on score === 5.00 (strict five-star), so
  // existing rows stay at 5.00 after the type widen.
  score       Decimal  @db.Decimal(3, 2)
  raterName   String   @map("rater_name") @db.VarChar(64)
  userId      Int?     @map("user_id")
  sessionCode String?  @map("session_code") @db.VarChar(16)
  ratedAt     DateTime @map("rated_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([wineName, userId])
  @@map("hall_of_fame")
}

// Badge catalog. Seeded from lib/badges.ts via ensureBadgesSeedOnce().
// IDs are stable string keys ("first_pour", "rated_10", etc.), not
// autoincrement integers — easier to reference from code.
model Badge {
  id          String      @id @db.VarChar(60)
  name        String      @db.VarChar(100)
  description String      @db.VarChar(255)
  icon        String      @db.VarChar(10)
  category    String      @db.VarChar(30)
  rarity      String      @default("common") @db.VarChar(20)
  xpReward    Int         @default(50) @map("xp_reward")
  earnedBy    UserBadge[]

  @@map("badges")
}

// Awarded-badge join table. (userId, badgeId) is unique — a user can earn
// each badge at most once. `seen` flips to true when the user views their
// badges list, used to drive the "new badge" notification dot.
model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  badgeId  String   @map("badge_id") @db.VarChar(60)
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)
  seen     Boolean  @default(false)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ── Social Feed ───────────────────────────────────────────────

// Explicit social graph — who follows whom.
model Follow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ── Unified rating / feed model ───────────────────
// Shipped via the rewire phases 1, 1.5, 2, 3, 4 (2026-05). The legacy
// `Checkin*` tables were dropped in phase 4 (migration
// `20260516125827_rewire_phase4_drop_checkins`). Design rationale:
// docs/dev/proposals/rewire.md.

// Lookup table that constrains (wines.category, wines.style) to a known set.
// Soft-deletable (`active=false`) because dropping a style row would break
// FKs from existing wines. UI dropdowns filter on active=true.
model CategoryStyle {
  category  String  @db.VarChar(32)
  style     String  @db.VarChar(64)
  label     String  @db.VarChar(64)
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  wines     Wine[]

  @@id([category, style])
  @@index([category, sortOrder])
  @@map("category_styles")
}

// Per-tasting photo album. Multiple photos per rating (live session AND
// standalone), distinct from the wine's canonical bottle shot
// (wines.imageUrl). Cascade on rating delete; S3 reclaim is independent
// of cascade and lives in every delete path (capture / commit / reclaim-after,
// per root CLAUDE.md cross-cutting rule).
model RatingImage {
  id        Int      @id @default(autoincrement())
  ratingId  Int      @map("rating_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ratingId, sortOrder])
  @@map("rating_images")
}

// The unified feed entry. Two kinds today: 'session' (one per (user, session)
// — wraps every rating that user made in that session) and 'standalone'
// (one per check-in — wraps a single rating). Future kinds extend the
// enum without schema changes. See rewire.md §2 for the full reasoning.
model FeedItem {
  id             Int            @id @default(autoincrement())
  // NOT NULL — anon ratings never get feed_items (§3). Forcing non-null
  // prevents accidental anon writes from reaching the table.
  userId         Int            @map("user_id")
  // 'session' | 'standalone' today. Immutable once set.
  kind           String         @db.VarChar(32)
  sessionId      Int?           @map("session_id")
  // Standalone is 1:1 with a rating; session enumerates ratings via
  // (userId, sessionId) on the ratings table — no ratingId here.
  ratingId       Int?           @unique @map("rating_id")
  venueName      String?        @map("venue_name") @db.VarChar(255)
  city           String?        @db.VarChar(100)
  country        String?        @db.Char(2)
  lat            Decimal?       @db.Decimal(9, 6)
  lng            Decimal?       @db.Decimal(9, 6)
  // false = render no location at all; true = render venue/city. Boolean,
  // not enum — the "private tasting" signal is UX copy, not data (§2).
  locationPublic Boolean        @default(false) @map("location_public")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict: hard-deleting a session must fail loudly. Soft-delete
  // (sessions.deletedAt) is the contract; the §8 tombstone preserves the
  // FK so the JOIN keeps rendering "[deleted session]" tombstones.
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  // Standalone is 1:1 with a rating; cascade is correct (the post is the
  // social wrapper of the rating).
  rating         Rating?        @relation(fields: [ratingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  likes          FeedItemLike[]
  tags           FeedItemTag[]

  // One feed_item per (user, session) — prevents double-creation under
  // concurrent rates via ON CONFLICT DO NOTHING (§2). NULLs are distinct
  // in Postgres unique constraints, so standalone rows (sessionId IS NULL)
  // are unconstrained — exactly what we want.
  @@unique([userId, sessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("feed_items")
}

// Likes on a feed item. Cascade matches today's checkin_likes pattern: the
// liker deleting their account drops the edge; the author keeps the post.
model FeedItemLike {
  userId     Int      @map("user_id")
  feedItemId Int      @map("feed_item_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, feedItemId])
  @@index([feedItemId])
  @@map("feed_item_likes")
}

// Tags on a feed item. Cascade matches today's checkin_tags pattern: the
// tagged user deleting their account drops the edge; the author keeps the
// post (the social signal alone goes).
model FeedItemTag {
  feedItemId Int      @map("feed_item_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([feedItemId, userId])
  @@index([userId])
  @@map("feed_item_tags")
}

