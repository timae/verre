{
  "name": "verre",
  "version": "3.0.0",
  "description": "Wine tasting OS — shared sessions, radar profiles, PDF export",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@better-auth/core": "1.7.18"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "if command -v patch-package >/dev/null 2>&1; then patch-package; else echo 'patch-package not installed - skipping patches'; fi",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-8080}",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/lib-storage": "^3.1163.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.74.4",
    "autoprefixer": "^10.5.0",
    "bcrypt": "^6.0.0",
    "better-auth": "1.7.18",
    "framer-motion": "^12.38.0",
    "nanoid": "^3.3.12",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.25",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^5.5.7",
    "react-zoom-pan-pinch": "^4.0.3",
    "redis": "^4.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
