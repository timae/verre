{
  "name": "verre",
  "version": "3.0.0",
  "description": "Wine tasting OS — shared sessions, radar profiles, PDF export",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "@better-auth/core": "1.6.15"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
